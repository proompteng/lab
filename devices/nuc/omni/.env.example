# Persistent installation identity. bootstrap.sh generates this once.
OMNI_ACCOUNT_UUID=

# First Omni administrator and Tailscale OIDC client created in tsidp.
OMNI_ADMIN_EMAIL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Only needed for the first tsidp registration. Clear it after tsidp is online.
TSIDP_AUTH_KEY=

# NUC and tailnet identity. validate.sh detects drift before deployment.
NUC_TAILSCALE_IP=100.78.240.108
OMNI_HOST=nuc.ide-newton.ts.net
OIDC_ISSUER_URL=https://tsidp.ide-newton.ts.net

# Persistent host storage. This must remain an absolute, dedicated directory.
OMNI_DATA_ROOT=/var/lib/omni

# Full-state backup preflight preserves this many bytes beyond the uncompressed input size.
OMNI_BACKUP_MIN_FREE_BYTES=10737418240
