+    async fn test_reuses_raw_block_device_without_host_path() {
+        let entry = std::fs::read_dir("/sys/dev/block")
+            .expect("Linux block device sysfs is required")
+            .next()
+            .expect("a Linux block device is required")
+            .unwrap();
+        let numbers = entry.file_name().to_string_lossy().to_string();
+        let (major, minor) = numbers.split_once(':').unwrap();
+        let dm = new_device_manager().await.unwrap();
+        let block_driver = get_block_device_info(&dm).await.block_device_driver;
+        let config = DeviceConfig::BlockCfgModern(BlockConfigModern {
+            major: major.parse().unwrap(),
+            minor: minor.parse().unwrap(),
+            driver_option: block_driver,
+            ..Default::default()
+        });
+        let first = dm.write().await.new_device(&config).await.unwrap();
+        let second = dm.write().await.new_device(&config).await.unwrap();
+        assert_eq!(
+            first, second,
+            "a restarted container must reuse the existing block device"
+        );
+        assert_eq!(dm.read().await.devices.len(), 1);
+    }
