+fn block_volume_annotation_key(device_name: &str, suffix: &str) -> String {
+    format!("{BLOCK_VOLUME_ANNOTATION_PREFIX}.{device_name}.{suffix}")
+}
+
+fn block_volume_device_name(container_path: &str) -> Option<String> {
+    let device_name = container_path.strip_prefix("/dev/")?.replace('/', "_");
+    if device_name.is_empty() {
+        return None;
+    }
+    Some(device_name)
+}
+
+fn block_volume_mount_path(value: &str) -> Result<PathBuf> {
+    let path = Path::new(value);
+    if !path.is_absolute() || path == Path::new("/") {
+        return Err(anyhow!(
+            "block auto-mount destination must be an absolute non-root path: {value}"
+        ));
+    }
+    if path
+        .components()
+        .any(|component| !matches!(component, Component::RootDir | Component::Normal(_)))
+    {
+        return Err(anyhow!(
+            "block auto-mount destination must be normalized: {value}"
+        ));
+    }
+    Ok(path.to_path_buf())
+}
+
+fn build_block_automounts(
+    annotations: &HashMap<String, String>,
+    devices: &[agent::types::Device],
+    container_id: &str,
+) -> Result<Vec<(agent::Storage, oci::Mount)>> {
+    let mut automounts = Vec::new();
+
+    for device in devices {
+        let Some(device_name) = block_volume_device_name(&device.container_path) else {
+            continue;
+        };
+        let mount_path_key =
+            block_volume_annotation_key(&device_name, BLOCK_VOLUME_MOUNT_PATH_SUFFIX);
+        let Some(mount_path) = annotations.get(&mount_path_key) else {
+            continue;
+        };
+        let mount_path = block_volume_mount_path(mount_path)?;
+
+        let fs_type_key = block_volume_annotation_key(&device_name, BLOCK_VOLUME_FS_TYPE_SUFFIX);
+        let fs_type = annotations
+            .get(&fs_type_key)
+            .map(String::as_str)
+            .unwrap_or(SUPPORTED_BLOCK_VOLUME_FS_TYPE);
+        if fs_type != SUPPORTED_BLOCK_VOLUME_FS_TYPE {
+            return Err(anyhow!(
+                "unsupported block auto-mount filesystem {fs_type} for {}",
+                device.container_path
+            ));
+        }
+
+        let fs_group_key = block_volume_annotation_key(&device_name, BLOCK_VOLUME_FS_GROUP_SUFFIX);
+        let fs_group = annotations
+            .get(&fs_group_key)
+            .map(|value| {
+                value
+                    .parse::<u32>()
+                    .with_context(|| format!("invalid block auto-mount fs_group {value}"))
+                    .map(|group_id| agent::FSGroup {
+                        group_id,
+                        group_change_policy: agent::FSGroupChangePolicy::OnRootMismatch,
+                    })
+            })
+            .transpose()?;
+
+        let sandbox_mount_point = format!(
+            "/run/kata-containers/shared/containers/{container_id}/block-volume-{device_name}"
+        );
+        let storage = agent::Storage {
+            driver: device.field_type.clone(),
+            driver_options: vec![KATA_BLOCK_VOLUME_ENSURE_FS.to_owned()],
+            source: device.id.clone(),
+            fs_type: fs_type.to_owned(),
+            fs_group,
+            mount_point: sandbox_mount_point.clone(),
+            ..Default::default()
+        };
+
+        let mut mount = oci::Mount::default();
+        mount.set_destination(mount_path);
+        mount.set_typ(Some("bind".to_owned()));
+        mount.set_source(Some(PathBuf::from(sandbox_mount_point)));
+        mount.set_options(Some(vec!["bind".to_owned(), "rw".to_owned()]));
+
+        automounts.push((storage, mount));
+    }
+
+    Ok(automounts)
+}
