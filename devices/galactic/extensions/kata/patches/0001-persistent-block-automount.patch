+                KATA_BLOCK_VOLUME_INITIALIZE_FS.to_owned(),
+            ]
+        );
+
+        let invalid_annotations = HashMap::from([
+            (
+                "io.katacontainers.volume.tengri-home.mount_path".to_owned(),
+                "/home/nanoagent".to_owned(),
+            ),
+            (
+                "io.katacontainers.volume.tengri-home.initialize_fs".to_owned(),
+                "yes".to_owned(),
+            ),
+        ]);
+        assert!(build_block_automounts(&invalid_annotations, &devices).is_err());
+    }
+
+    #[test]
+    fn reuses_one_sandbox_mount_for_the_same_device() {
+        let devices = vec![block_device("/dev/tengri-home", "0000:00:04.0")];
+        let annotations = HashMap::from([(
+            "io.katacontainers.volume.tengri-home.mount_path".to_owned(),
+            "/home/nanoagent".to_owned(),
+        )]);
+
+        let first = build_block_automounts(&annotations, &devices).unwrap();
+        let second = build_block_automounts(&annotations, &devices).unwrap();
+
+        assert_eq!(first[0].0.mount_point, second[0].0.mount_point);
+    }
+
+    #[test]
+    fn block_device_annotation_encoding_is_collision_free() {
+        assert_eq!(
+            block_volume_device_name("/dev/a/b").as_deref(),
+            Some("a_2fb")
+        );
+        assert_eq!(
+            block_volume_device_name("/dev/a_b").as_deref(),
+            Some("a_5fb")
+        );
+        assert_ne!(
+            block_volume_device_name("/dev/a/b"),
+            block_volume_device_name("/dev/a_b")
+        );
+    }
+
