+        || !value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.'))
+    {
+        return Err(anyhow!(
+            "block auto-mount initialization token must be 16-128 ASCII letters, digits, dots, dashes, or underscores"
+        ));
+    }
+    Ok(value)
+}
