+    let length_offset = PERSISTENT_BLOCK_MARKER_MAGIC.len();
+    let token_offset = length_offset + std::mem::size_of::<u16>();
+    let token_end = token_offset + token.len();
+    marker[..length_offset].copy_from_slice(PERSISTENT_BLOCK_MARKER_MAGIC);
+    marker[length_offset..token_offset].copy_from_slice(&(token.len() as u16).to_le_bytes());
