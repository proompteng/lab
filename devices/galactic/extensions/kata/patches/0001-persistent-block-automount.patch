+fn persistent_initialization_token(storage: &Storage) -> Result<Option<String>> {
+    let prefix = format!("{KATA_BLOCK_VOLUME_INITIALIZE_FS}=");
+    let mut token = None;
+
+    for option in &storage.driver_options {
+        if option == KATA_BLOCK_VOLUME_INITIALIZE_FS {
+            return Err(anyhow!(
+                "{} requires a unique provisioning token",
+                KATA_BLOCK_VOLUME_INITIALIZE_FS
+            ));
+        }
+        let Some(value) = option.strip_prefix(&prefix) else {
+            continue;
+        };
+        validate_persistent_initialization_token(value)?;
+        if token.replace(value.to_owned()).is_some() {
+            return Err(anyhow!(
+                "{} may be specified only once",
+                KATA_BLOCK_VOLUME_INITIALIZE_FS
+            ));
+        }
+    }
+
+    Ok(token)
+}
