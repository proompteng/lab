+/// Key to request idempotent filesystem preparation for persistent block storage.
+///
+/// Unlike [`KATA_BLOCK_VOLUME_CREATE_FS`], this option preserves an existing
+/// filesystem and only creates one when the device is verifiably blank.
+pub const KATA_BLOCK_VOLUME_ENSURE_FS: &str = "ensure_filesystem";
+
+/// Key to authorize filesystem creation for a newly provisioned persistent block volume.
+///
+/// This option is only valid together with [`KATA_BLOCK_VOLUME_ENSURE_FS`]. Callers must
+/// emit it only while initializing a volume they authoritatively know has never held data.
+pub const KATA_BLOCK_VOLUME_INITIALIZE_FS: &str = "initialize_filesystem";
+
