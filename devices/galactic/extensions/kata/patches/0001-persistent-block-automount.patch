+        let sandbox_mount_point =
+            format!("/run/kata-containers/shared/volumes/block-volume-{source_name}");
+        let initialization_token_key =
+            block_volume_annotation_key(&device_name, BLOCK_VOLUME_INITIALIZATION_TOKEN_SUFFIX);
+        let mut driver_options = vec![KATA_BLOCK_VOLUME_ENSURE_FS.to_owned()];
+        if let Some(value) = annotations.get(&initialization_token_key) {
+            let token = block_volume_initialization_token(value).with_context(|| {
+                format!(
+                    "invalid block auto-mount initialization token for {}",
+                    device.container_path
+                )
+            })?;
+            driver_options.push(format!("{KATA_BLOCK_VOLUME_INITIALIZE_FS}={token}"));
+        }
+        let storage = agent::Storage {
+            driver: device.field_type.clone(),
+            driver_options,
+            source: device.id.clone(),
+            fs_type: fs_type.to_owned(),
+            fs_group,
+            mount_point: sandbox_mount_point.clone(),
+            ..Default::default()
+        };
+
+        let mut mount = oci::Mount::default();
+        mount.set_destination(mount_path);
+        mount.set_typ(Some("bind".to_owned()));
+        mount.set_source(Some(PathBuf::from(sandbox_mount_point)));
+        mount.set_options(Some(vec!["bind".to_owned(), "rw".to_owned()]));
+
+        automounts.push((storage, mount));
+    }
+
+    Ok(automounts)
+}
