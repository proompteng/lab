+async fn persistent_block_initialization_marker(
+    source: &str,
+) -> Result<PersistentBlockInitializationMarker> {
+    let mut device = tokio::fs::File::open(source)
+        .await
+        .with_context(|| format!("open block device {source}"))?;
+    let mut marker = [0_u8; PERSISTENT_BLOCK_MARKER_BYTES];
+    device
+        .read_exact(&mut marker)
+        .await
+        .with_context(|| format!("read persistent block initialization marker from {source}"))?;
+
+    if marker.iter().all(|byte| *byte == 0) {
+        return Ok(PersistentBlockInitializationMarker::Blank);
+    }
+    if !marker.starts_with(PERSISTENT_BLOCK_MARKER_MAGIC) {
+        return Ok(PersistentBlockInitializationMarker::Occupied);
+    }
