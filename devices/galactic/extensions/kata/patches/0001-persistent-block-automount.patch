+        .await
+        .with_context(|| format!("open block device {source}"))?;
+    let mut buffer = vec![0_u8; BLANK_DEVICE_SCAN_BUFFER_BYTES];
+    let mut total_bytes_read = 0_u64;
+
+    loop {
+        let count = device
+            .read(&mut buffer)
+            .await
+            .with_context(|| format!("read block device {source}"))?;
+        if count == 0 {
+            break;
+        }
+        total_bytes_read += count as u64;
+
+        if buffer[..count].iter().any(|byte| *byte != 0) {
+            return Ok(false);
+        }
+    }
+
+    if total_bytes_read == 0 {
+        return Err(anyhow!("block device {source} returned no data"));
+    }
+
+    Ok(true)
+}
