+    let length_offset = PERSISTENT_BLOCK_MARKER_MAGIC.len();
+    let token_offset = length_offset + std::mem::size_of::<u16>();
+    let token_length =
+        u16::from_le_bytes([marker[length_offset], marker[length_offset + 1]]) as usize;
+    let token_end = token_offset.saturating_add(token_length);
+    if token_end > marker.len() || marker[token_end..].iter().any(|byte| *byte != 0) {
+        return Ok(PersistentBlockInitializationMarker::Occupied);
+    }
