+async fn block_device_has_ext4_filesystem(source: &str) -> Result<bool> {
+    let mut device = tokio::fs::File::open(source)
+        .await
+        .with_context(|| format!("open block device {source}"))?;
+    device
+        .seek(std::io::SeekFrom::Start(EXT4_MAGIC_OFFSET))
+        .await
+        .with_context(|| format!("seek block device {source}"))?;
+    let mut magic = [0_u8; EXT4_MAGIC.len()];
+    device
+        .read_exact(&mut magic)
+        .await
+        .with_context(|| format!("read ext4 superblock magic from {source}"))?;
+    Ok(magic == EXT4_MAGIC)
+}
+
+async fn check_ext4_filesystem(source: &str) -> Result<()> {
+    let output = run_block_command(E2FSCK, &["-p"], source).await?;
+    match output.status.code() {
+        // e2fsck uses 0 for clean and 1 for corrected errors.
+        Some(0 | 1) => Ok(()),
+        _ => Err(anyhow!(
+            "{} failed for {}: status={}, stdout={}, stderr={}",
+            E2FSCK,
+            source,
+            output.status,
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr)
+        )),
+    }
+}
+
+async fn create_persistent_ext4_filesystem(source: &str) -> Result<()> {
+    let output = run_block_command(MKFS_EXT4, &PERSISTENT_EXT4_MKFS_OPTS, source).await?;
+    if output.status.success() {
+        return Ok(());
+    }
+
+    Err(anyhow!(
+        "{} failed for {}: status={}, stdout={}, stderr={}",
+        MKFS_EXT4,
+        source,
+        output.status,
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
