{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "flamingo/qwen38-flamingo",
  "providers": {
    "flamingo": {
      "name": "Flamingo",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://flamingo.flamingo.svc.cluster.local/v1"
      },
      "models": {
        "qwen38-flamingo": {
          "name": "Flamingo Qwen3.8 27B FP8",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "temperature": true
          },
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "relay": {
        "type": "local",
        "command": [
          "relay-client"
        ],
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 35000
        },
        "protocol": "legacy"
      }
    }
  }
}
