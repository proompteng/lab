{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCaptureObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::bayn-research/captures/v1/*"
    },
    {
      "Sid": "WritePrivateCaptureObjects",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::bayn-research/captures/v1/*",
      "Condition": {
        "StringEquals": { "s3:x-amz-acl": "private" },
        "Null": {
          "s3:x-amz-grant-read": "true",
          "s3:x-amz-grant-write": "true",
          "s3:x-amz-grant-read-acp": "true",
          "s3:x-amz-grant-write-acp": "true",
          "s3:x-amz-grant-full-control": "true"
        }
      }
    },
    {
      "Sid": "DenyAllOtherActions",
      "Effect": "Deny",
      "NotAction": ["s3:PutObject", "s3:GetObject"],
      "Resource": "*"
    },
    {
      "Sid": "DenyOutsideCapturePrefix",
      "Effect": "Deny",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "NotResource": "arn:aws:s3:::bayn-research/captures/v1/*"
    },
    {
      "Sid": "DenyNonPrivateUploads",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "*",
      "Condition": { "StringNotEqualsIfExists": { "s3:x-amz-acl": "private" } }
    },
    {
      "Sid": "DenyReadGrants",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "*",
      "Condition": { "Null": { "s3:x-amz-grant-read": "false" } }
    },
    {
      "Sid": "DenyWriteGrants",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "*",
      "Condition": { "Null": { "s3:x-amz-grant-write": "false" } }
    },
    {
      "Sid": "DenyReadAclGrants",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "*",
      "Condition": { "Null": { "s3:x-amz-grant-read-acp": "false" } }
    },
    {
      "Sid": "DenyWriteAclGrants",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "*",
      "Condition": { "Null": { "s3:x-amz-grant-write-acp": "false" } }
    },
    {
      "Sid": "DenyFullControlGrants",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "*",
      "Condition": { "Null": { "s3:x-amz-grant-full-control": "false" } }
    }
  ]
}
