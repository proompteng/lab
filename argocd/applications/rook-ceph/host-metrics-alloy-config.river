logging {
	level  = "info"
	format = "logfmt"
}

// This per-node collector has no Kubernetes credentials or remote discovery.
// Host networking is required for genuine host (not pod) network counters.
// The HTTP listener stays on loopback; exporter scraping uses in-memory traffic.
prometheus.exporter.unix "storage" {
	procfs_path    = "/host/proc"
	sysfs_path     = "/host/sys"
	set_collectors = ["cpu", "diskstats", "ethtool", "meminfo", "netclass", "netdev", "pressure"]

	disk {
		device_include = "^(sd[a-z]+|nvme[0-9]+n[0-9]+|rbd[0-9]+)$"
	}

	// GET-only hardware reads refresh mlx5 PHY counters cached by netdev.
	ethtool {
		device_include  = "^(enp1s0f1np1|ens1f1np1)$"
		metrics_include = "^(rx_(discards_phy|out_of_buffer|crc_errors_phy|symbol_err_phy|pcs_symbol_err_phy|wqe_err|buff_alloc_err|recover|congst_umr)|tx_(discards_phy|cqe_err|recover)|[rt]x_(packets|bytes|pause_ctrl)_phy)$"
	}

	netdev {
		device_include = "^(en.*|eth.*|bond[0-9]+|tailscale[0-9]+|flannel[.][0-9]+|siderolink)$"
	}

	netclass {
		ignored_devices = "^(lo|veth.*|cni.*|docker.*|virbr.*)$"
	}
}

discovery.relabel "storage" {
	targets = prometheus.exporter.unix.storage.targets

	// Embedded Unix targets already carry job="integrations/unix". A scrape
	// job_name is only a default; override the target label for our rule contract.
	rule {
		replacement  = "node-storage"
		target_label = "job"
	}

	rule {
		replacement  = sys.env("NODE_NAME")
		target_label = "node"
	}

	rule {
		replacement  = sys.env("NODE_NAME")
		target_label = "instance"
	}
}

prometheus.relabel "storage" {
	forward_to = [prometheus.remote_write.mimir.receiver]

	rule {
		action        = "keep"
		source_labels = ["__name__"]
		regex         = "up|node_scrape_collector_(success|duration_seconds)|node_cpu_seconds_total|node_memory_(MemAvailable|MemTotal)_bytes|node_pressure_.*|node_disk_.*|node_ethtool_.*|node_network_((receive|transmit)_(bytes|drop|errs|packets)_total|speed_bytes|mtu_bytes|up|carrier|carrier_changes_total)"
	}
}

prometheus.scrape "storage" {
	job_name        = "node-storage"
	targets         = discovery.relabel.storage.output
	scrape_interval = "30s"
	scrape_timeout  = "10s"
	forward_to      = [prometheus.relabel.storage.receiver]
}

prometheus.remote_write "mimir" {
	endpoint {
		url = "http://observability-mimir-gateway.observability.svc.cluster.local/api/v1/push"
	}
}
