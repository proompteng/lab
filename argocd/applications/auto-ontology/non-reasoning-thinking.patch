+def _non_reasoning_disable_thinking() -> bool:
+    """Whether non-reasoning clients disable Qwen3/vLLM thinking tokens."""
+    raw = os.environ.get("AUTO_ONTOLOGY_NON_REASONING_DISABLE_THINKING", "true")
+    return raw.strip().lower() not in {"0", "false", "no", "off"}
+
+
+def _is_chat_completions_post(method: object, url: object) -> bool:
+    """Whether *method* / *url* targets a chat completions POST endpoint."""
+    if str(method).upper() != "POST":
+        return False
+    return urlsplit(str(url)).path.rstrip("/").endswith("/chat/completions")
+
+
+def _with_thinking_disabled(payload: dict) -> dict:
+    """Return a shallow copy of *payload* with thinking disabled by default."""
+    updated = dict(payload)
+    existing = updated.get("chat_template_kwargs")
+    if isinstance(existing, dict):
+        chat_template_kwargs = dict(existing)
+        chat_template_kwargs.setdefault("enable_thinking", False)
+    else:
+        chat_template_kwargs = {"enable_thinking": False}
+    updated["chat_template_kwargs"] = chat_template_kwargs
+    return updated
+
+
+def _has_json_content_type(headers: object) -> bool:
+    if not isinstance(headers, Mapping):
+        return False
+    for key, value in headers.items():
+        if str(key).lower() == "content-type" and "application/json" in str(value).lower():
+            return True
+    return False
+
+
+def _drop_content_length_header(kwargs: dict) -> None:
+    headers = kwargs.get("headers")
+    if not isinstance(headers, Mapping):
+        return
+    if any(str(key).lower() == "content-length" for key in headers):
+        kwargs["headers"] = {
+            key: value
+            for key, value in headers.items()
+            if str(key).lower() != "content-length"
+        }
+
+
