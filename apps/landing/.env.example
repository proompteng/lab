# Copy the Convex deployment URL from packages/backend/.env.local after running
# `bun run dev:setup:convex`
NEXT_PUBLIC_CONVEX_URL=
# URL of the Payload CMS instance (e.g. https://cms.proompteng.ai)
LANDING_CMS_URL=

# Local Tengri BFF. Never commit real values.
TENGRI_DESKTOP_ORIGIN=https://proompteng.ai
TENGRI_OIDC_ISSUER=https://auth.proompteng.ai/realms/tengri
TENGRI_OIDC_CLIENT_SECRET_FILE=
OFZ_GRPC_ENDPOINT=ofz-api.ofz.svc.cluster.local:9443
TENGRI_DATABASE_DSN=postgres://tengri_bff@ofz-db-rw.ofz.svc.cluster.local:5432/tengri_control
TENGRI_DATABASE_PASSWORD_FILE=
TENGRI_DATABASE_CA_FILE=

# The control plane requires SPIFFE mutual TLS, including local development.
# Run a local SPIRE agent and register the two configured workload identities.
TENGRI_GRPC_ENDPOINT=localhost:50051
SPIFFE_ENDPOINT_SOCKET=unix:///spiffe-workload-api/spire-agent.sock
SPIFFE_ID=spiffe://proompteng.ai/ns/proompteng/sa/proompteng
TENGRI_SPIFFE_ID=spiffe://proompteng.ai/ns/tengri/sa/tengri
TENGRI_INTERNAL_HMAC_SECRET=

# Browser gateway origins used to construct the Content Security Policy. The
# preview source may be an exact HTTPS origin or a trusted wildcard DNS zone.
TENGRI_PUBLIC_URL=https://tengri.proompteng.ai
TENGRI_PREVIEW_FRAME_SOURCE=

# Optional override. The app otherwise resolves the checked-in service proto.
TENGRI_PROTO_PATH=
