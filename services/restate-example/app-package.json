{
  "name": "@proompteng/restate-example",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end Restate durable execution example service.",
  "type": "module",
  "scripts": {
    "dev": "bun src/server.ts",
    "start": "bun src/server.ts",
    "lint": "bunx oxfmt --check src",
