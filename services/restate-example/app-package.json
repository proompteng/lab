    "lint:oxlint:type": "oxlint --config ../../.oxlintrc.json --type-aware --tsconfig ./tsconfig.json .",
    "test": "bun test",
    "tsc": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@restatedev/restate-sdk": "1.16.4",
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
