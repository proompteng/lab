+    /// Send only over a connection that is already registered. Unlike try_send, this never
+    /// creates or restarts a connection attempt. A captured Connection avoids a readiness race.
+    pub fn try_send_ready(&mut self, message: M) -> Result<(), TrySendError<M>> {
+        let Some(connection) = self.connection_manager.get_connection(message.to()) else {
+            return Err(TrySendError::Connecting(message));
+        };
+        message.serialize(&mut self.serde_buffer);
+        let network_message = grpc_svc::NetworkMessage {
+            payload: self.serde_buffer.split().freeze(),
+        };
+        connection.try_send(network_message).map_err(|_| TrySendError::Send(message))
+    }
