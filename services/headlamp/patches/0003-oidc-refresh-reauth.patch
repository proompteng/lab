+			IdpIssuerURL: "https://issuer.example",
+		},
+	}))
+
+	config := auth.OIDCTokenRefreshConfig{
+		KubeConfigStore:    kubeConfigStore,
+		Cache:              cache.New[interface{}](),
+		TelemetryHandler:   &telemetry.RequestHandler{},
+		OidcUseAccessToken: true,
+		SessionTTL:         86400,
+	}
+
+	handlerCalled := false
