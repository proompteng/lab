{
  "version": 1,
  "resources": [
    {
      "kind": "kubernetes.namespace",
      "nativeType": "kubernetes_namespace",
      "relations": [
        { "name": "status_reader", "subjects": ["human", "workload"] },
        { "name": "log_reader", "subjects": ["human", "workload"] },
        { "name": "event_reader", "subjects": ["human", "workload"] }
      ]
    },
    { "kind": "tengri.workspace", "nativeType": "workspace", "relations": [] }
  ],
  "actions": [
    {
      "id": "kubernetes.status.read",
      "resourceKind": "kubernetes.namespace",
      "permission": "read_status",
      "grantRelation": "status_reader"
    },
    {
      "id": "kubernetes.logs.read",
      "resourceKind": "kubernetes.namespace",
      "permission": "read_logs",
      "grantRelation": "log_reader"
    },
    {
      "id": "kubernetes.events.read",
      "resourceKind": "kubernetes.namespace",
      "permission": "read_events",
      "grantRelation": "event_reader"
    },
    { "id": "tengri.delegations.manage", "resourceKind": "tengri.workspace", "permission": "manage_grants" }
  ]
}
