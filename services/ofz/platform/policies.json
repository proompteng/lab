{
  "version": 1,
  "resources": [
    {
      "kind": "kubernetes.namespace",
      "nativeType": "kubernetes_namespace",
      "relations": [
        {
          "name": "status_reader",
          "subjects": ["human", "workload"]
        },
        {
          "name": "log_reader",
          "subjects": ["human", "workload"]
        },
        {
          "name": "event_reader",
          "subjects": ["human", "workload"]
        },
        {
          "name": "status_workspace",
          "subjects": ["workspace"]
        },
        {
          "name": "log_workspace",
          "subjects": ["workspace"]
        },
        {
          "name": "event_workspace",
          "subjects": ["workspace"]
        }
      ],
      "workspaceScoped": true
    },
    {
      "kind": "tengri.workspace",
      "nativeType": "workspace",
      "relations": [],
      "workspaceScoped": false
    },
    {
      "kind": "platform.workspace",
      "nativeType": "platform_workspace",
      "workspaceScoped": false,
      "relations": [
        {
          "name": "member",
          "subjects": ["human"]
        },
        {
          "name": "administrator",
          "subjects": ["human"]
        },
        {
          "name": "client",
          "subjects": ["workload"]
        }
      ]
    },
    {
      "kind": "agents.target",
      "nativeType": "agents_target",
      "relations": [
        {
          "name": "reader",
          "subjects": ["human", "workload"]
        },
        {
          "name": "reader_workspace",
          "subjects": ["workspace"]
        },
        {
          "name": "log_reader",
          "subjects": ["human", "workload"]
        },
        {
          "name": "log_reader_workspace",
          "subjects": ["workspace"]
        },
        {
          "name": "starter",
          "subjects": ["human", "workload"]
        },
        {
          "name": "starter_workspace",
          "subjects": ["workspace"]
        },
        {
          "name": "canceller",
          "subjects": ["human", "workload"]
        },
        {
          "name": "canceller_workspace",
          "subjects": ["workspace"]
        }
      ],
      "workspaceScoped": true
    }
  ],
  "actions": [
    {
      "id": "kubernetes.status.read",
      "resourceKind": "kubernetes.namespace",
      "permission": "read_status",
      "grantRelation": "status_reader",
      "workspaceGrantRelation": "status_workspace"
    },
    {
      "id": "kubernetes.logs.read",
      "resourceKind": "kubernetes.namespace",
      "permission": "read_logs",
      "grantRelation": "log_reader",
      "workspaceGrantRelation": "log_workspace"
    },
    {
      "id": "kubernetes.events.read",
      "resourceKind": "kubernetes.namespace",
      "permission": "read_events",
      "grantRelation": "event_reader",
      "workspaceGrantRelation": "event_workspace"
    },
    {
      "id": "tengri.delegations.manage",
      "resourceKind": "tengri.workspace",
      "permission": "manage_grants"
    },
    {
      "id": "agents.runs.read",
      "resourceKind": "agents.target",
      "permission": "read",
      "grantRelation": "reader",
      "workspaceGrantRelation": "reader_workspace"
    },
    {
      "id": "agents.runs.logs",
      "resourceKind": "agents.target",
      "permission": "read_logs",
      "grantRelation": "log_reader",
      "workspaceGrantRelation": "log_reader_workspace"
    },
    {
      "id": "agents.runs.start",
      "resourceKind": "agents.target",
      "permission": "start",
      "grantRelation": "starter",
      "workspaceGrantRelation": "starter_workspace"
    },
    {
      "id": "agents.runs.cancel",
      "resourceKind": "agents.target",
      "permission": "cancel",
      "grantRelation": "canceller",
      "workspaceGrantRelation": "canceller_workspace"
    }
  ]
}
