definition platform_workspace {
    relation platform: platform
    relation member: human
    relation administrator: human
    relation client: workload

    permission human_member = (member + administrator) & platform->admit
    permission use = human_member + client
    permission manage = administrator & platform->admit
}

definition platform_delegation {
    relation subject: agent with expiration
    relation issuer: human
    permission use = subject
}
