{
  "version": 1,
  "services": [
    {
      "id": "ofz",
      "identities": ["spiffe://proompteng.ai/ns/ofz/sa/ofz-api"],
      "roles": ["ofz.server"],
      "display_name": "Ofz"
    },
    {
      "id": "tengri-web",
      "identities": ["spiffe://proompteng.ai/ns/proompteng/sa/proompteng"],
      "roles": ["tengri.web", "relay.client", "platform.client"],
      "session_gateway": {
        "oidc_client_id": "tengri-bff",
        "origin": "https://proompteng.ai"
      },
      "proof_audience": "https://proompteng.ai/api/platform/relay/agent",
      "binding": {
        "service": "tengri",
        "resourceKind": "tengri.workspace",
        "action": "tengri.delegations.manage"
      },
      "display_name": "Tengri"
    },
    {
      "id": "platform-admin",
      "identities": ["spiffe://proompteng.ai/ns/proompteng/sa/platform-admin"],
      "roles": ["platform.administration", "platform.client"],
      "session_gateway": {
        "oidc_client_id": "platform-admin",
        "origin": "https://admin.proompteng.ai"
      },
      "display_name": "Workspace administration"
    },
    {
      "id": "tengri",
      "identities": ["spiffe://proompteng.ai/ns/tengri/sa/tengri"],
      "roles": ["tengri.controller"],
      "display_name": "Tengri runtime"
    },
    {
      "id": "relay",
      "identities": ["spiffe://proompteng.ai/ns/relay/sa/relay"],
      "roles": ["relay.executor"],
      "display_name": "Relay"
    },
    {
      "id": "opencode",
      "identities": ["spiffe://proompteng.ai/ns/opencode/sa/opencode"],
      "roles": ["relay.client", "platform.client"],
      "display_name": "OpenCode"
    }
  ],
  "workspaces": [
    {
      "id": "e984074d-8b6d-5244-9fdb-59ff5d4a5836",
      "name": "Proompteng",
      "resources": [],
      "initial_clients": ["tengri-web", "opencode"],
      "import_platform_members": true
    }
  ]
}
