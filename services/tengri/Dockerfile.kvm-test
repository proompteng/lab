# syntax=mirror.gcr.io/docker/dockerfile:1.7
ARG RUNTIME_IMAGE
ARG NANOAGENT_TEST_IMAGE
FROM ${NANOAGENT_TEST_IMAGE} AS guest-tests
FROM mirror.gcr.io/rust:1.90.0-bookworm AS build
RUN apt-get update -o Acquire::Retries=3 && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends protobuf-compiler && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock build.rs ./
COPY proto ./proto
COPY src ./src
RUN (CARGO_BUILD_JOBS=2 cargo test --locked --release --no-run --bin tengri > /tmp/kvm-build.log 2>&1 || \
    { cat /tmp/kvm-build.log; exit 1; }) && \
    kvm_test="$(sed -nE 's/^ *Executable unittests src\/main.rs \((.*)\)$/\1/p' /tmp/kvm-build.log)" && \
    test -n "$kvm_test" && cp "$kvm_test" /out-kvm-test
FROM ${RUNTIME_IMAGE}
USER 0:0
RUN apt-get update -o Acquire::Retries=3 && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends util-linux && \
    rm -rf /var/lib/apt/lists/*
COPY --from=build /out-kvm-test /fixture/kvm-test
COPY --from=guest-tests /out/nanoagent-tests /fixture/nanoagent-tests
COPY --from=guest-tests /out/test-guest-admin.sh /fixture/test-guest-admin.sh
COPY --chmod=0555 test-kvm-entry.sh /fixture/entry
ENTRYPOINT ["/fixture/entry"]
