+fn write_sparse_memory<B: BitmapSlice, T: WriteVolatile + std::io::Seek>(
+    memory: &VolatileSlice<B>,
+    writer: &mut T,
+) -> Result<(), GuestMemoryError> {
+    let page_size = host_page_size();
+    let mut page = vec![0u8; page_size];
+    let mut start = 0;
+    let mut previous_zero = None;
+    let mut write_run = |start: usize, end: usize, zero: bool| {
+        if zero {
+            writer
+                .seek(SeekFrom::Current((end - start) as i64))
+                .map_err(GuestMemoryError::IOError)?;
+        } else {
+            writer.write_all_volatile(&memory.subslice(start, end - start)?)?;
+        }
+        Ok::<_, GuestMemoryError>(())
+    };
+    for offset in (0..memory.len()).step_by(page_size) {
+        let length = page_size.min(memory.len() - offset);
+        memory
+            .subslice(offset, length)?
+            .copy_to(&mut page[..length]);
+        let zero = page[..length].iter().all(|byte| *byte == 0);
+        if let Some(previous) = previous_zero {
+            if previous != zero {
+                write_run(start, offset, previous)?;
+                start = offset;
+            }
+        }
+        previous_zero = Some(zero);
+    }
+    if let Some(zero) = previous_zero {
+        write_run(start, memory.len(), zero)?;
+    }
+    Ok(())
+}
