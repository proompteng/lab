+                file.rewind().unwrap();
+                memory.dump(&mut file, false).unwrap();
+                file.sync_all().unwrap();
+                actual.clear();
+                std::fs::File::open(temporary.as_path())
+                    .unwrap()
+                    .read_to_end(&mut actual)
+                    .unwrap();
+                assert_eq!(actual, vec![0u8; size]);
+            }
+        }
