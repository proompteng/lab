+    #[test]
+    fn test_sparse_full_snapshot_bytes_and_existing_zero_overwrite() {
+        use std::fs::OpenOptions;
+        use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+
+        let page_size = host_page_size();
+        let size = 16 * page_size;
+        for direct in [false, true] {
+            for pattern in 0..3 {
+                let memory = into_region_ext(
+                    anonymous(
+                        [(GuestAddress(0), size)].into_iter(),
+                        true,
+                        HugePageConfig::None,
+                    )
+                    .unwrap(),
+                );
+                let mut expected = vec![0u8; size];
+                for index in 0..16 {
+                    if pattern == 1 || pattern == 2 && [0, 1, 4, 8, 9, 14].contains(&index) {
+                        expected[index * page_size..(index + 1) * page_size]
+                            .fill((index + 1) as u8);
+                    }
+                }
+                memory.write(&expected, GuestAddress(0)).unwrap();
+                let temporary = TempFile::new().unwrap();
+                let mut file = OpenOptions::new()
+                    .write(true)
+                    .custom_flags(if direct { libc::O_DIRECT } else { 0 })
+                    .open(temporary.as_path())
+                    .unwrap();
+                file.set_len(size as u64).unwrap();
+                memory.dump(&mut file, true).unwrap();
+                file.sync_all().unwrap();
+                if pattern != 1 {
+                    assert!(file.metadata().unwrap().blocks() * 512 < size as u64);
+                }
+                let mut actual = Vec::new();
+                std::fs::File::open(temporary.as_path())
+                    .unwrap()
+                    .read_to_end(&mut actual)
+                    .unwrap();
+                assert_eq!(actual, expected);
+
