diff --git a/dist/PgClient.js b/dist/PgClient.js
index 69086dea397ba44c2ba726c913a2b5dbf1cac136..0a621683eed60b62767eb65bcd9fc1cda1fbe230 100644
--- a/dist/PgClient.js
+++ b/dist/PgClient.js
@@ -88,30 +88,34 @@ class ConnectionImpl {
     this.connection = connection;
     this.streamAcquirer = streamAcquirer;
   }
+  traceBackend(effect, connection = this.connection) {
+    return Effect.withFiber(fiber => fiber.cache.tracerEnabled && fiber.getRef(Statement.SpanPropagationEnabled) ? Effect.andThen(Effect.annotateCurrentSpan("postgresql.pid", connection.processId), effect) : effect);
+  }
   run(query, params, prepare = true) {
-    return Effect.map(this.connection.query(query, params, prepare), result => result.rows);
+    return this.traceBackend(Effect.map(this.connection.query(query, params, prepare), result => result.rows));
   }
   execute(sql, params, transformRows) {
     return transformRows ? Effect.map(this.run(sql, params), transformRows) : this.run(sql, params);
   }
   executeRaw(sql, params) {
-    return this.connection.query(sql, params);
+    return this.traceBackend(this.connection.query(sql, params));
   }
   executeWithoutTransform(sql, params) {
     return this.run(sql, params);
   }
   executeValues(sql, params) {
-    return this.connection.queryValues(sql, params);
+    return this.traceBackend(this.connection.queryValues(sql, params));
   }
   executeValuesUnprepared(sql, params) {
-    return this.connection.queryValues(sql, params, false);
+    return this.traceBackend(this.connection.queryValues(sql, params, false));
   }
   executeUnprepared(sql, params, transformRows) {
     const operation = this.run(sql, params, false);
     return transformRows ? Effect.map(operation, transformRows) : operation;
   }
   executeStream(sql, params, transformRows) {
-    const stream = this.streamAcquirer === undefined ? this.connection.stream(sql, params) : Stream.unwrap(Effect.map(this.streamAcquirer, connection => connection.stream(sql, params)));
+    const streamFor = connection => Stream.unwrap(this.traceBackend(Effect.succeed(connection.stream(sql, params)), connection));
+    const stream = this.streamAcquirer === undefined ? streamFor(this.connection) : Stream.unwrap(Effect.map(this.streamAcquirer, streamFor));
     return transformRows ? Stream.mapArray(stream, rows => transformRows(rows)) : stream;
   }
 }
